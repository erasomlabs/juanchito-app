<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/atari_bg">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@color/atari_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvConsoleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/console_title"
            android:textColor="@color/atari_orange"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/atari_yellow"
            android:textSize="14sp"
            android:text="🪙 50"
            android:layout_marginEnd="12dp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnRemoveAds"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="NO ADS"
            android:textSize="10sp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_pad_small"
            android:textColor="@color/atari_white" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/atari_yellow"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Banner Ad Container in Menu -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Game selection grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGames"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/bannerContainer"
        app:layout_constraintBottom_toTopOf="@id/gamepadContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Game canvas (hidden by default) -->
    <erasom.juanchito.app.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/gamepadContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Virtual gamepad -->
    <LinearLayout
        android:id="@+id/gamepadContainer"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="@color/atari_panel"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- D-pad (left) -->
        <FrameLayout
            android:id="@+id/dpadContainer"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <Button
                android:id="@+id/btnUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/btn_pad"
                android:text="▲"
                android:textColor="@color/atari_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/btn_pad"
                android:text="◀"
                android:textColor="@color/atari_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/btn_pad"
                android:text="▶"
                android:textColor="@color/atari_white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/btn_pad"
                android:text="▼"
                android:textColor="@color/atari_white"
                android:textSize="12sp" />
        </FrameLayout>

        <!-- Center buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelect"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_pad_small"
                android:text="SELECT"
                android:textColor="@color/atari_white"
                android:textSize="10sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:background="@drawable/btn_pad_small"
                android:text="START"
                android:textColor="@color/atari_white"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- A/B buttons (right) -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_gravity="center">

            <Button
                android:id="@+id/btnB"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/btn_action"
                android:text="B"
                android:textColor="@color/atari_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnA"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/btn_action"
                android:text="A"
                android:textColor="@color/atari_white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
